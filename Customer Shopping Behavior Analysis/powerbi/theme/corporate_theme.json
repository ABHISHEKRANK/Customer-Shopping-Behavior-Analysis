{
  "name": "Retail Corporate",
  "dataColors": ["#1F3A5F", "#2A9D8F", "#E9C46A", "#E76F51", "#6C8EBF", "#8AB17D", "#B5838D", "#7F7F7F"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1F3A5F",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#E76F51",
  "maximum": "#1F3A5F",
  "center": "#E9C46A",
  "minimum": "#E76F51",
  "textClasses": {
    "title":    { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#1F3A5F" },
    "header":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F3A5F" },
    "label":    { "fontSize": 10, "fontFace": "Segoe UI", "color": "#4B5563" },
    "callout":  { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1F3A5F" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F3A5F" } }, "fontSize": 12 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 6 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F4F6" } }, "transparency": 0 }]
      }
    }
  }
}
